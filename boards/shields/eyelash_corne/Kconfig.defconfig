if SHIELD_EYELASH_CORNE_LEFT

config ZMK_KEYBOARD_NAME
    default "Eyelash Corne"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif # SHIELD_EYELASH_CORNE_LEFT


if SHIELD_EYELASH_CORNE_LEFT || SHIELD_EYELASH_CORNE_RIGHT

config ZMK_SPLIT
    default y

config BT_CTLR
    default BT

if USB

config USB_NRFX
    default y

config USB_DEVICE_STACK
    default y

endif # USB

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

# The panel is mounted with its long axis running front-to-back, so ZMK's
# landscape built-in status screen reads sideways. display/ replaces it with a
# vertical one; see display/canvas.h for how rotation is handled.
choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

# The status screen draws into an off-screen canvas and blits 1bpp images.
# Neither is on by default in Zephyr's LVGL configuration.
config LV_USE_CANVAS
    default y

config LV_USE_IMG
    default y

# 8x8 bitmap font. Montserrat is antialiased and dithers badly at 1bpp.
config LV_FONT_UNSCII_8
    default y

config LV_Z_MEM_POOL_SIZE
    default 4096

# Drives the bongo cat on the peripheral. The peripheral never sees keycodes,
# so its own figure stays 0; the useful value is relayed from the central by
# display/wpm_relay.c, which needs the event type compiled on both halves.
config ZMK_WPM
    default y

endif # ZMK_DISPLAY

if SSD1306

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # SSD1306

if ZMK_BACKLIGHT

config PWM
    default y

config LED_PWM
    default y

endif # ZMK_BACKLIGHT

endif # SHIELD_EYELASH_CORNE_LEFT || SHIELD_EYELASH_CORNE_RIGHT